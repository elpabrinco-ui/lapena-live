<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#7A1F2B"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="32dp">

  <ImageView
    android:layout_width="140dp"
    android:layout_height="140dp"
    android:layout_marginBottom="24dp"
    android:contentDescription="La Peña FC"
    android:src="@drawable/crest" />

  <Button
    android:id="@+id/btnModeStream"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginBottom="16dp"
    android:backgroundTint="#FFFFFF"
    android:textColor="#7A1F2B"
    android:textSize="20sp"
    android:textStyle="bold"
    android:text="📹  TRANSMITIR" />

  <Button
    android:id="@+id/btnModeControl"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:backgroundTint="#141414"
    android:textColor="#FFFFFF"
    android:textSize="20sp"
    android:textStyle="bold"
    android:text="🎛  CONTROLAR MARCADOR" />

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:gravity="center"
    android:textColor="#FFC9C9"
    android:text="Un celular transmite. Otro celular maneja el marcador con el mismo código de partido." />
</LinearLayout>
