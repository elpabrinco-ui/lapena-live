<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:keepScreenOn="true"
  android:background="@android:color/black">

  <SurfaceView
    android:id="@+id/surfaceView"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

  <!-- Top: stream key + status -->
  <LinearLayout
    android:id="@+id/topPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:layout_margin="8dp"
    android:background="@drawable/panel_bg"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <EditText
      android:id="@+id/etKey"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:hint="@string/hint_key"
      android:inputType="textPassword"
      android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
      android:singleLine="true"
      android:textColor="@android:color/white"
      android:textColorHint="#BBBBBB" />

    <Button
      android:id="@+id/btnPaste"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:text="PEGAR" />

    <TextView
      android:id="@+id/tvStatus"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:text="Sin transmitir"
      android:textColor="@android:color/white"
      android:textSize="14sp" />
  </LinearLayout>

  <!-- Bottom left: match code for the control phone -->
  <TextView
    android:id="@+id/tvCode"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|start"
    android:layout_margin="12dp"
    android:background="@drawable/panel_bg"
    android:padding="10dp"
    android:text="Código: ------"
    android:textColor="@android:color/white"
    android:textSize="16sp"
    android:textStyle="bold" />

  <!-- Bottom right: buttons -->
  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_margin="12dp"
    android:orientation="horizontal">

    <Button
      android:id="@+id/btnSaver"
      android:layout_width="wrap_content"
      android:layout_height="64dp"
      android:layout_marginEnd="12dp"
      android:text="AHORRO" />

    <Button
      android:id="@+id/btnSwitch"
      android:layout_width="wrap_content"
      android:layout_height="64dp"
      android:layout_marginEnd="12dp"
      android:text="@string/switch_camera" />

    <Button
      android:id="@+id/btnStartStop"
      android:layout_width="wrap_content"
      android:layout_height="64dp"
      android:minWidth="160dp"
      android:backgroundTint="#C62828"
      android:textColor="@android:color/white"
      android:textStyle="bold"
      android:textSize="18sp"
      android:text="@string/start" />
  </LinearLayout>

  <!-- Saver mode: black screen on top of everything; tap to exit -->
  <TextView
    android:id="@+id/saverCover"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:gravity="center"
    android:text="Modo ahorro · la transmisión sigue\nTocá la pantalla para volver"
    android:textColor="#555555"
    android:textSize="16sp"
    android:visibility="gone" />
</FrameLayout>
